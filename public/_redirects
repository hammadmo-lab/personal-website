# Cloudflare Pages redirect rules for SPA
# Static assets should be served directly, HTML requests go to index.html

# Serve static files directly (images, fonts, etc.)
/*.jpg   200
/*.jpeg  200
/*.png   200
/*.gif   200
/*.svg   200
/*.webp  200
/*.ico   200
/*.woff  200
/*.woff2 200
/*.ttf   200
/*.eot   200
/*.css   200
/*.js    200
/*.json  200
/*.xml   200
/*.txt   200

# All other requests (HTML) go to index.html for SPA routing
/*       /index.html   200
