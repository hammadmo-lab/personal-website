---
import Base from '../layouts/Base.astro';
import { getPageUrl } from '../i18n';
---
<Base locale="en" page="home" standalone={{ title: 'Page not found | Dr. Mohamed Amin Hammad', description: 'This page does not exist.' }}>
  <section class="wrap not-found">
    <p class="eyebrow">404</p>
    <h1>This page isn't here.</h1>
    <p class="lede">The link may be old or mistyped. Start again from the home page:</p>
    <div class="actions">
      <a class="btn" href={getPageUrl('en', 'home')}>Home</a>
      <a class="text-link" href={getPageUrl('ar', 'home')} lang="ar" dir="rtl">الصفحة الرئيسية</a>
      <a class="text-link" href={getPageUrl('es', 'home')} lang="es">Inicio</a>
    </div>
  </section>
</Base>

<style>
  .not-found { display: grid; gap: 1.25rem; justify-items: start; padding-block: clamp(4rem, 12vw, 9rem); }
  .not-found h1 { font-size: var(--step-4); }
</style>
