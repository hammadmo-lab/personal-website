---
import Base from '../../layouts/Base.astro';
import StoreLinks from '../../components/StoreLinks.astro';
import { LINKS, type Locale } from '../../i18n';
import { copyFor, localePaths } from '../../lib/site';

export const getStaticPaths = localePaths;

const { locale } = Astro.props as { locale: Locale };
const copy = copyFor(locale);
const travel = copy.travel;
---
<Base locale={locale} page="travel">
  <section class="glow"><div class="wrap travel-hero">
    <div class="travel-hero__copy">
      <p class="eyebrow eyebrow--line">{travel.eyebrow}</p>
      <h1 lang="en">{travel.title}</h1>
      <p class="lede">{travel.intro}</p>
      <div class="actions">
        <a class="btn" href={LINKS.passportTrails} target="_blank" rel="noopener noreferrer">
          {travel.primaryCta}<span class="sr-only"> {copy.common.newTab}</span>
        </a>
        <a class="text-link" href="#app">{travel.helperCta} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <blockquote class="travel-quote"><p>{travel.quote}</p></blockquote>
    </div>
    <figure class="framed travel-hero__photo">
      <img src="/images/iceland.jpg" alt={travel.imageAlt} width="768" height="1024" fetchpriority="high" />
      <figcaption>{travel.imageCaption}</figcaption>
    </figure>
  </div></section>

  <section class="section light">
    <div class="wrap lens">
      <div class="lens__head">
        <p class="eyebrow">{travel.lensEyebrow}</p>
        <h2>{travel.lensTitle}</h2>
      </div>
      <div class="prose">
        {travel.lensParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="section stories-section" aria-labelledby="stories-title">
    <div class="wrap">
      <div class="stories__head">
        <div class="section-head">
          <p class="eyebrow">{travel.featuredEyebrow}</p>
          <h2 id="stories-title">{travel.featuredTitle}</h2>
        </div>
        <a class="text-link" href={LINKS.passportTrails} target="_blank" rel="noopener noreferrer">
          {copy.common.visitPassportTrails} <span class="arrow" aria-hidden="true">→</span><span class="sr-only"> {copy.common.newTab}</span>
        </a>
      </div>
      <ul class="stories">
        {travel.stories.map((story) => (
          <li>
            <a class="story" href={story.href} target="_blank" rel="noopener noreferrer">
              <span class="eyebrow">{story.label}</span>
              <span class="story__title">{story.title}</span>
              <span class="muted">{story.desc}</span>
              <span class="story__cta">{copy.common.readArticle} <span class="arrow" aria-hidden="true">→</span></span>
              <span class="sr-only"> {copy.common.newTab}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section light">
    <div class="wrap diary">
      <p class="eyebrow">{travel.visualEyebrow}</p>
      <h2>{travel.visualTitle}</h2>
      <div class="diary__text">
        {travel.visualParagraphs.map((paragraph) => <p class="muted">{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="places-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{travel.destinationsEyebrow}</p>
        <h2 id="places-title">{travel.destinationsTitle}</h2>
      </div>
      <ul class="places">
        {travel.destinations.map(([name, flag, note]) => (
          <li class="place">
            <span class="place__name"><span aria-hidden="true">{flag}</span> {name}</span>
            <span class="muted">{note}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="app-band light" id="app" aria-labelledby="app-title">
    <div class="wrap app-band__grid">
      <div class="app-band__copy">
        <p class="eyebrow">{travel.helperEyebrow}</p>
        <h2 id="app-title">{travel.helperTitle}</h2>
        <p class="app-band__intro">{travel.helperIntro}</p>
      </div>
      <div class="app-band__side">
        <ul class="app-band__features">
          {travel.helperFeatures.map((feature) => <li>{feature}</li>)}
        </ul>
        <p class="app-band__get">{travel.getApp}</p>
        <StoreLinks locale={locale} ios={LINKS.passportTrailsIos} android={LINKS.passportTrailsAndroid} appName="Passport Trails" />
      </div>
    </div>
  </section>
</Base>

<style>
  .travel-hero { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(2rem, 6vw, 5rem); align-items: center; padding-block: clamp(3rem, 7vw, 5.5rem); }
  .travel-hero__copy { display: grid; gap: 1.4rem; }
  .travel-hero h1 { font-size: var(--step-4); line-height: 1; letter-spacing: -0.02em; }
  .travel-hero__photo { justify-self: center; width: min(100%, 25rem); }
  .travel-hero__photo img { aspect-ratio: 3 / 4; }
  .travel-quote { margin: 0.75rem 0 0; border-inline-start: 2px solid var(--gold); padding-inline-start: 1.25rem; }
  .travel-quote p { font-family: var(--f-display); font-style: italic; font-size: var(--step-1); line-height: 1.45; max-width: 34rem; }
  :global([dir='rtl']) .travel-quote p { font-style: normal; }

  .lens { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(2rem, 6vw, 5rem); }
  .lens__head { display: grid; gap: 0.9rem; align-content: start; }
  .lens h2 { font-size: var(--step-3); }

  .stories-section { border-bottom: 1px solid var(--line); }
  .stories__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1rem 2rem; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .stories__head .section-head { margin-bottom: 0; }
  .stories { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  .story { display: grid; gap: 0.7rem; height: 100%; align-content: start; padding: 1.75rem; border: 1px solid var(--line); background: var(--surface); text-decoration: none; transition: border-color 0.2s ease, transform 0.2s ease; }
  .story:hover { border-color: var(--gold); transform: translateY(-3px); }
  .story__title { font-family: var(--f-display); font-size: var(--step-1); line-height: 1.3; }
  .story__cta { color: var(--accent); font-weight: 600; margin-top: 0.5rem; }
  .story .muted { color: var(--muted); }

  .diary { display: grid; gap: 1.25rem; }
  .diary h2 { font-size: var(--step-3); max-width: 24ch; }
  .diary__text { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem clamp(2rem, 5vw, 4rem); max-width: 60rem; margin-top: 0.5rem; }

  .places { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); }
  .place { display: grid; gap: 0.4rem; align-content: start; padding: 1.5rem 1.5rem 1.5rem 0; border-bottom: 1px solid var(--line); }
  :global([dir='rtl']) .place { padding: 1.5rem 0 1.5rem 1.5rem; }
  .place__name { font-family: var(--f-display); font-size: var(--step-1); }
  .place .muted { font-size: 0.95rem; color: var(--muted); }

  .app-band { padding-block: clamp(3.5rem, 8vw, 6rem); }
  .app-band__grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .app-band__copy { display: grid; gap: 1.25rem; }
  .app-band h2 { font-size: var(--step-3); }
  .app-band__intro { color: var(--muted); max-width: 36rem; }
  .app-band__side { display: grid; gap: 1.25rem; }
  .app-band__features { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .app-band__features li { padding-bottom: 0.6rem; border-bottom: 1px solid var(--line); }
  .app-band__get { font-size: 0.85rem; color: var(--faint); }

  @media (max-width: 56rem) {
    .travel-hero, .lens, .app-band__grid { grid-template-columns: 1fr; }
    .travel-hero__photo { max-width: 24rem; }
    .stories { grid-template-columns: 1fr; }
    .places { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 36rem) {
    .places, .diary__text { grid-template-columns: 1fr; }
    .place, :global([dir='rtl']) .place { padding-inline: 0; }
  }
</style>
