---
import Base from '../../layouts/Base.astro';
import StoreLinks from '../../components/StoreLinks.astro';
import { LINKS, getPageUrl, type Locale } from '../../i18n';
import { copyFor, localePaths } from '../../lib/site';

export const getStaticPaths = localePaths;

const { locale } = Astro.props as { locale: Locale };
const copy = copyFor(locale);
const radly = copy.radly;
---
<Base locale={locale} page="radly">
  <section class="radly glow">
    <div class="wrap radly__grid">
      <div class="radly__copy">
        <p class="eyebrow eyebrow--line">{radly.eyebrow}</p>
        <h1 lang="en">{radly.title}</h1>
        <p class="radly__intro">{radly.intro}</p>
        <ul class="radly__features">
          {radly.features.map((feature) => <li>{feature}</li>)}
        </ul>
        <StoreLinks locale={locale} ios={LINKS.radlyIos} android={LINKS.radlyAndroid} appName="Radly" />
        <a class="radly__visit" href={LINKS.radly} target="_blank" rel="noopener noreferrer">
          {radly.visit} <span class="arrow" aria-hidden="true">→</span><span class="sr-only"> {copy.common.newTab}</span>
        </a>
      </div>
      <figure class="radly__shot">
        <div class="radly__viewer">
          <span class="radly__meta radly__meta--tl" aria-hidden="true">RADLY · REPORT</span>
          <span class="radly__meta radly__meta--tr" aria-hidden="true">W 400 · L 40</span>
          <img src="/images/radly-app.jpg" alt={radly.imageAlt} width="1024" height="777" loading="lazy" />
        </div>
      </figure>
    </div>
  </section>

  <section class="section light">
    <div class="wrap radly-next">
      <p class="radly-next__text">{copy.about.paragraphs[1]}</p>
      <a class="btn" href={getPageUrl(locale, 'contact')}>{copy.home.contactCta}</a>
    </div>
  </section>
</Base>

<style>
  /* Radly: product page with a scan-viewer frame around the app. */
  .radly { padding-block: clamp(3.5rem, 8vw, 6.5rem); }
  .radly__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(2rem, 6vw, 5rem); align-items: center; }
  .radly__copy { display: grid; gap: 1.5rem; justify-items: start; }
  .radly h1 { font-size: var(--step-4); line-height: 1; letter-spacing: -0.02em; }
  .radly__intro { color: var(--muted); font-size: var(--step-1); max-width: 36rem; }
  .radly__features { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; width: 100%; max-width: 30rem; }
  .radly__features li { display: flex; gap: 0.75rem; align-items: baseline; padding-bottom: 0.6rem; border-bottom: 1px solid var(--line); }
  .radly__features li::before { content: ''; flex: none; width: 0.9rem; height: 1px; background: var(--gold); transform: translateY(-0.3em); }
  .radly__visit { color: var(--text); text-decoration: none; border-bottom: 1px solid var(--line); padding-bottom: 0.1rem; font-weight: 500; }
  .radly__visit:hover { border-bottom-color: var(--gold); color: var(--gold); }
  .radly :focus-visible { outline-color: var(--gold); }

  .radly__shot { margin: 0; }
  .radly__viewer { position: relative; padding: 2.25rem 1rem 1rem; border: 1px solid var(--line); background: #080506; }
  .radly__viewer img { width: 100%; }
  .radly__meta { position: absolute; top: 0.7rem; font-size: 0.68rem; letter-spacing: 0.12em; color: var(--muted); font-family: ui-monospace, Menlo, monospace; }
  .radly__meta--tl { inset-inline-start: 1rem; }
  .radly__meta--tr { inset-inline-end: 1rem; }

  .radly-next { display: grid; gap: 1.5rem; justify-items: start; }
  .radly-next__text { font-family: var(--f-display); font-size: var(--step-2); line-height: 1.35; max-width: 46rem; }

  @media (max-width: 56rem) {
    .radly__grid { grid-template-columns: 1fr; }
  }
</style>
