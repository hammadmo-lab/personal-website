---
import Base from '../../layouts/Base.astro';
import StoreLinks from '../../components/StoreLinks.astro';
import { LINKS, getPageUrl, type Locale } from '../../i18n';
import { copyFor, localePaths } from '../../lib/site';

export const getStaticPaths = localePaths;

const { locale } = Astro.props as { locale: Locale };
const copy = copyFor(locale);
const radly = copy.radly;
const newTab = copy.common.newTab;
---
<Base locale={locale} page="radly">
  <section class="radly glow">
    <div class="wrap radly__hero">
      <p class="radly__pill">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 2l1.9 5.6L19.5 9l-5.6 1.9L12 16.5l-1.9-5.6L4.5 9l5.6-1.4L12 2zm7 11l.9 2.6 2.6.9-2.6.9L19 20l-.9-2.6-2.6-.9 2.6-.9L19 13z"/></svg>
        {radly.eyebrow}
      </p>
      <h1>
        <span class="radly__lead">{radly.titleLead}</span>
        <span class="radly__accent">{radly.titleAccent}</span>
      </h1>
      <p class="radly__intro">{radly.intro}</p>

      <figure class="radly__shot">
        <img src="/images/radly-desk.jpg" alt={radly.imageAlt} width="1316" height="536" fetchpriority="high" />
      </figure>

      <div class="radly__ctas">
        <a class="btn radly__primary" href={LINKS.radly} target="_blank" rel="noopener noreferrer">
          {radly.primaryCta} <span class="arrow" aria-hidden="true">→</span><span class="sr-only"> {newTab}</span>
        </a>
        <a class="btn btn--outline" href={LINKS.radly} target="_blank" rel="noopener noreferrer">
          {radly.secondaryCta}<span class="sr-only"> {newTab}</span>
        </a>
      </div>
      <ul class="radly__perks">
        {radly.perks.map((perk) => <li>{perk}</li>)}
      </ul>

      <div class="radly__get">
        <p class="eyebrow">{radly.getOnYourTerms}</p>
        <div class="radly__stores">
          <StoreLinks locale={locale} ios={LINKS.radlyIos} android={LINKS.radlyAndroid} appName="Radly" />
          {LINKS.radlyTelegram && (
            <a class="telegram" href={LINKS.radlyTelegram} target="_blank" rel="noopener noreferrer">
              <span class="telegram__small">{radly.telegramSmall}</span>
              <span class="telegram__name" lang="en">{radly.telegramName}</span>
              <span class="sr-only"> {newTab}</span>
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="section light">
    <div class="wrap story">
      <div class="story__text">
        <p class="eyebrow">{radly.storyTitle}</p>
        <p class="story__quote">{radly.story}</p>
        <a class="text-link" href={LINKS.radly} target="_blank" rel="noopener noreferrer">
          {radly.visit} <span class="arrow" aria-hidden="true">→</span><span class="sr-only"> {newTab}</span>
        </a>
      </div>
      <ul class="story__features">
        {radly.features.map((feature) => <li>{feature}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap radly-contact">
      <p class="lede">{copy.contact.intro}</p>
      <a class="btn btn--outline" href={getPageUrl(locale, 'contact')}>{copy.home.contactCta}</a>
    </div>
  </section>
</Base>

<style>
  /* Radly keeps its own product voice: bold sans headline, centred, gold gradient accent. */
  .radly { padding-block: clamp(3.5rem, 8vw, 6rem) clamp(3.5rem, 7vw, 5.5rem); }
  .radly::before { background: radial-gradient(60% 50% at 50% 0%, rgba(214, 173, 114, 0.12), transparent 70%), radial-gradient(50% 60% at 50% 55%, var(--wine-glow), transparent 75%); }
  .radly__hero { display: grid; justify-items: center; text-align: center; gap: 1.75rem; }

  .radly__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 1.1rem;
    border: 1px solid rgba(214, 173, 114, 0.45);
    border-radius: 999px;
    color: var(--gold);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  :global([dir='rtl']) .radly__pill { letter-spacing: 0; font-size: 0.95rem; }

  .radly h1 {
    font-family: var(--f-body);
    font-weight: 750;
    font-size: clamp(2.4rem, 1.2rem + 5vw, 5.25rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    max-width: 16ch;
    display: grid;
    gap: 0.15em;
  }
  :global([dir='rtl']) .radly h1 { letter-spacing: 0; line-height: 1.35; font-weight: 600; }
  .radly__lead { color: var(--cream); }
  .radly__accent {
    background: linear-gradient(180deg, #f3d9a4 0%, #d6ad72 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .radly__intro { color: var(--muted); font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.3rem); max-width: 40rem; }

  .radly__shot { margin: 0.75rem 0 0; width: 100%; max-width: 62rem; }
  .radly__shot img {
    width: 100%;
    border-radius: 1rem;
    border: 1px solid rgba(214, 173, 114, 0.35);
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.85), 0 0 0 6px rgba(214, 173, 114, 0.05);
  }

  .radly__ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.9rem; margin-top: 0.5rem; }
  .radly__ctas .btn { border-radius: 0.75rem; min-height: 3.4rem; padding-inline: 2rem; font-size: 1.02rem; }
  .radly__primary { background: linear-gradient(180deg, #f3d9a4, #d6ad72); border: 0; box-shadow: 0 12px 30px -12px rgba(214, 173, 114, 0.6); }
  .radly__primary:hover { background: linear-gradient(180deg, #f7e2b6, #e0b87f); }

  .radly__perks { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 1.75rem; color: var(--muted); font-size: 0.95rem; }
  .radly__perks li { display: inline-flex; align-items: center; gap: 0.5rem; }
  .radly__perks li::before { content: '✓'; display: grid; place-items: center; width: 1.15rem; height: 1.15rem; border: 1px solid var(--gold); border-radius: 50%; color: var(--gold); font-size: 0.65rem; }

  .radly__get { display: grid; justify-items: center; gap: 1rem; margin-top: 1.5rem; }
  .radly__stores { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; }
  .radly__stores :global(.stores a) { border-radius: 0.75rem; border-color: rgba(214, 173, 114, 0.45); min-width: 11rem; padding: 0.7rem 1.25rem; }
  .telegram { display: grid; min-width: 11rem; padding: 0.7rem 1.25rem; border-radius: 0.75rem; border: 1px solid #2aa3df; background: rgba(42, 163, 223, 0.1); color: var(--cream); text-decoration: none; line-height: 1.25; text-align: start; }
  .telegram:hover { background: rgba(42, 163, 223, 0.2); }
  .telegram__small { font-size: 0.75rem; color: #7cc9ef; }
  .telegram__name { font-weight: 600; font-size: 1.05rem; font-family: 'Hanken Grotesk Variable', Arial, sans-serif; }

  .story { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .story__text { display: grid; gap: 1.5rem; justify-items: start; }
  .story__quote { font-family: var(--f-display); font-size: var(--step-2); line-height: 1.4; }
  .story__features { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .story__features li { display: flex; gap: 0.85rem; align-items: baseline; padding-block: 1rem; border-bottom: 1px solid var(--line); font-weight: 500; }
  .story__features li::before { content: ''; flex: none; width: 0.45rem; height: 0.45rem; background: var(--wine); transform: rotate(45deg) translateY(-0.15em); }

  .radly-contact { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem; }

  @media (max-width: 52rem) {
    .story { grid-template-columns: 1fr; }
  }
</style>
