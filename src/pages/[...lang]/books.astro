---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { type Locale } from '../../i18n';
import { absoluteUrl, copyFor, localePaths } from '../../lib/site';
import { bookSchema } from '../../lib/schema';

export const getStaticPaths = localePaths;

const { locale } = Astro.props as { locale: Locale };
const copy = copyFor(locale);
const books = copy.books;
const featured = books.featured;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': bookSchema(),
  url: absoluteUrl(locale, 'books'),
};
---
<Base locale={locale} page="books" ogImage={featured.cover} structuredData={structuredData}>
  <PageHead eyebrow={books.subtitle} title={books.title}>
    <div class="intro prose">
      {books.intro.map((paragraph) => <p class="muted">{paragraph}</p>)}
    </div>
  </PageHead>

  <article class="featured" aria-labelledby="featured-title">
    <div class="wrap featured__grid">
      <div class="featured__cover">
        <img src={featured.cover} alt={featured.alt} width="1000" height="1600" fetchpriority="high" />
      </div>
      <div class="featured__body">
        <p class="eyebrow">{featured.eyebrow}</p>
        <h2 id="featured-title" lang="en">{featured.title}</h2>
        <p class="featured__subtitle" lang="en">{featured.subtitle}</p>
        <p class="featured__author" lang="en">{featured.author}</p>
        <blockquote class="featured__tagline"><p>{featured.tagline}</p></blockquote>
        <div class="prose">
          {featured.description.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <ul class="featured__bullets">
          {featured.bullets.map((bullet) => <li>{bullet}</li>)}
        </ul>
        <p class="featured__closing">{featured.closing}</p>
        <div class="actions">
          {featured.links.map((link) => (
            <a class:list={['btn', { 'btn--ghost': !link.primary }]} href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}<span class="sr-only"> {books.newTab}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </article>

  <section class="section wrap" aria-label={books.items[0]?.title}>
    <ul class="shelf">
      {books.items.map((book) => (
        <li class="shelf__item">
          <img src={book.cover} alt={book.alt} width="640" height="1024" loading="lazy" />
          <div class="shelf__body">
            <h2 lang="en">{book.title}</h2>
            <p class="muted">{book.desc}</p>
            {book.links.map((link) => (
              <a class="text-link" href={link.href} target="_blank" rel="noopener noreferrer">
                {link.label} <span class="arrow" aria-hidden="true">→</span><span class="sr-only"> {books.newTab}</span>
              </a>
            ))}
          </div>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .intro { margin-top: 0.5rem; max-width: 44rem; }

  .featured { background: var(--surface); border-block: 1px solid var(--line); padding-block: clamp(3rem, 7vw, 5.5rem); }
  .featured__grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .featured__cover { position: sticky; top: 7rem; }
  .featured__cover img { width: 100%; aspect-ratio: 5 / 8; object-fit: cover; box-shadow: 0 30px 50px -28px rgba(27, 28, 26, 0.55); }
  .featured__body { display: grid; gap: 1.25rem; max-width: 40rem; }
  .featured h2 { font-size: var(--step-4); line-height: 1; letter-spacing: -0.02em; }
  .featured__subtitle { font-size: var(--step-1); color: var(--pencil); line-height: 1.45; }
  .featured__author { font-size: 0.78rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--pencil); font-family: 'Instrument Sans', Arial, sans-serif; }
  .featured__tagline { margin: 0.75rem 0; padding-inline-start: 1.25rem; border-inline-start: 2px solid var(--wine); }
  .featured__tagline p { font-family: var(--f-display); font-style: italic; font-size: var(--step-2); line-height: 1.35; color: var(--wine); }
  .featured__bullets { list-style: none; margin: 0.5rem 0; padding: 0; display: grid; gap: 0.7rem; }
  .featured__bullets li { display: flex; gap: 0.85rem; align-items: baseline; }
  .featured__bullets li::before { content: ''; flex: none; width: 0.4rem; height: 0.4rem; background: var(--gold); transform: rotate(45deg) translateY(-0.2em); }
  .featured__closing { font-family: var(--f-display); font-size: var(--step-2); }

  .shelf { list-style: none; margin: 0; padding: 0; display: grid; gap: 2rem; }
  .shelf__item { display: grid; grid-template-columns: minmax(0, 10rem) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: center; max-width: 46rem; }
  .shelf__item img { width: 100%; aspect-ratio: 5 / 8; object-fit: cover; box-shadow: 0 20px 35px -22px rgba(27, 28, 26, 0.55); }
  .shelf__body { display: grid; gap: 0.85rem; justify-items: start; }
  .shelf__body h2 { font-size: var(--step-2); }

  @media (max-width: 52rem) {
    .featured__grid { grid-template-columns: 1fr; }
    .featured__cover { position: static; max-width: 15rem; }
  }
  @media (max-width: 30rem) {
    .shelf__item { grid-template-columns: 7rem minmax(0, 1fr); }
  }
</style>
