---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { AMAZON_AUTHOR_URL, BOOKS, type Locale } from '../../i18n';
import { absoluteUrl, copyFor, localePaths } from '../../lib/site';
import { booksSchema } from '../../lib/schema';

export const getStaticPaths = localePaths;

const { locale } = Astro.props as { locale: Locale };
const copy = copyFor(locale);
const books = copy.books;
const featured = books.featured;
const newest = featured[0];
const booksUrl = absoluteUrl(locale, 'books');
---
<Base locale={locale} page="books" ogImage={newest.cover} schema={booksSchema(booksUrl)}>
  <PageHead eyebrow={books.subtitle} title={books.title}>
    <div class="intro prose">
      {books.intro.map((paragraph) => <p class="lede">{paragraph}</p>)}
    </div>
  </PageHead>

  {featured.map((book, index) => (
    <article
      class="featured light"
      id={book.title === BOOKS.iSwear.title ? 'i-swear-ill-find-you' : undefined}
      aria-labelledby={`featured-title-${index}`}
    >
      <div class="wrap featured__grid">
        <div class="featured__cover">
          {index === 0
            ? <img src={book.cover} alt={book.alt} width="1000" height="1600" fetchpriority="high" />
            : <img src={book.cover} alt={book.alt} width="1000" height="1600" loading="lazy" />}
        </div>
        <div class="featured__body">
          {'eyebrow' in book && <p class="eyebrow">{book.eyebrow}</p>}
          <h2 id={`featured-title-${index}`} lang="en">{book.title}</h2>
          <p class="featured__subtitle" lang="en">{book.subtitle}</p>
          <p class="featured__author" lang="en">{book.author}</p>
          {'series' in book && <p class="featured__author" lang="en">{book.series}</p>}
          <blockquote class="featured__tagline"><p>{book.tagline}</p></blockquote>
          {book.title === BOOKS.lightUnderDoor.title && (
            <figure class="trailer">
              <div class="trailer__frame">
                <iframe
                  src="https://www.youtube-nocookie.com/embed/l21uSBvPd6k"
                  title="The Light Under the Door — Official Book Trailer"
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  allowfullscreen
                  referrerpolicy="strict-origin-when-cross-origin"
                ></iframe>
              </div>
              <figcaption>{books.trailerLabel}</figcaption>
            </figure>
          )}
          <div class="prose">
            {book.description.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <ul class="featured__bullets">
            {book.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>
          <p class="featured__closing">{book.closing}</p>
          <div class="actions">
            {book.links.map((link) => (
              <a class:list={['btn', { 'btn--outline': !link.primary }]} href={link.href} target="_blank" rel="noopener noreferrer">
                {link.label}<span class="sr-only"> {books.newTab}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </article>
  ))}

  <section class="section author-amazon" aria-label={books.amazonCta}>
    <div class="wrap author-amazon__inner">
      <p class="lede">{books.amazonLead}</p>
      <a class="btn" href={AMAZON_AUTHOR_URL} target="_blank" rel="noopener noreferrer">
        {books.amazonCta}<span class="sr-only"> {books.newTab}</span>
      </a>
    </div>
  </section>
</Base>

<style>
  .intro { margin-top: 0.5rem; max-width: 44rem; }

  .featured { padding-block: clamp(3.5rem, 8vw, 6rem); }
  .featured__grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .featured__cover { position: sticky; top: 7rem; }
  .featured__cover img { width: 100%; aspect-ratio: 5 / 8; object-fit: cover; box-shadow: 0 30px 50px -28px rgba(27, 28, 26, 0.55); }
  .featured__body { display: grid; gap: 1.25rem; max-width: 40rem; }
  .featured h2 { font-size: var(--step-4); line-height: 1; letter-spacing: -0.02em; }
  .featured__subtitle { font-size: var(--step-1); color: var(--muted); line-height: 1.45; }
  .featured__author { font-size: 0.78rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--faint); font-weight: 600; font-family: 'Hanken Grotesk Variable', Arial, sans-serif; }
  .featured__tagline { margin: 0.75rem 0; padding-inline-start: 1.25rem; border-inline-start: 2px solid var(--wine); }
  .featured__tagline p { font-family: var(--f-display); font-style: italic; font-size: var(--step-2); line-height: 1.35; color: var(--wine); }
  .featured__bullets { list-style: none; margin: 0.5rem 0; padding: 0; display: grid; gap: 0.7rem; }
  .featured__bullets li { display: flex; gap: 0.85rem; align-items: baseline; }
  .featured__bullets li::before { content: ''; flex: none; width: 0.45rem; height: 0.45rem; background: var(--wine); transform: rotate(45deg) translateY(-0.2em); }
  .featured__closing { font-family: var(--f-display); font-size: var(--step-2); }

  .trailer { display: grid; gap: 0.65rem; margin: 0.25rem 0 0.5rem; }
  .trailer__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--night);
    border: 1px solid var(--gold);
    box-shadow: 0 24px 40px -28px rgba(20, 12, 13, 0.55);
  }
  .trailer__frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .trailer figcaption {
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-deep);
    font-weight: 600;
  }
  :global([dir='rtl']) .trailer figcaption { letter-spacing: 0; text-transform: none; font-size: 1rem; }

  .author-amazon { border-top: 1px solid var(--line); }
  .author-amazon__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.25rem 2rem; }
  .author-amazon .lede { max-width: 36rem; }

  @media (max-width: 52rem) {
    .featured__grid { grid-template-columns: 1fr; }
    .featured__cover { position: static; max-width: 15rem; }
  }
</style>
