---
interface Props {
  eyebrow: string;
  title: string;
  titleLang?: string;
}
const { eyebrow, title, titleLang } = Astro.props;
---
<header class="page-head glow">
  <div class="wrap page-head__inner">
    <p class="eyebrow eyebrow--line">{eyebrow}</p>
    <h1 lang={titleLang}>{title}</h1>
    <slot />
  </div>
</header>

<style>
  .page-head { border-bottom: 1px solid var(--line); }
  .page-head__inner { display: grid; gap: 1.25rem; padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(2.5rem, 5vw, 4rem); }
  .page-head h1 { font-size: var(--step-4); line-height: 0.98; letter-spacing: -0.02em; max-width: 16ch; }
  :global([dir='rtl']) .page-head h1 { line-height: 1.3; }
</style>
