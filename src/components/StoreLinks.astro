---
import type { Locale } from '../i18n';
import { copyFor } from '../lib/site';

interface Props {
  locale: Locale;
  ios: string;
  android: string;
  appName: string;
}
const { locale, ios, android, appName } = Astro.props;
const copy = copyFor(locale);
const stores = [
  { name: copy.common.appStore, href: ios },
  { name: copy.common.googlePlay, href: android },
];
---
<ul class="stores">
  {stores.map((store) => (
    <li>
      <a href={store.href} target="_blank" rel="noopener noreferrer">
        <span class="stores__small">{copy.common.getOn}</span>
        <span class="stores__name" lang="en">{store.name}</span>
        <span class="sr-only"> · {appName} {copy.common.newTab}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .stores { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .stores a { display: grid; min-width: 9.75rem; padding: 0.6rem 1.1rem; text-decoration: none; border: 1px solid var(--outline); color: var(--text); line-height: 1.25; transition: border-color 0.2s ease, background-color 0.2s ease; }
  .stores a:hover { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, transparent); }
  .stores__small { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--faint); }
  :global([dir='rtl']) .stores__small { letter-spacing: 0; text-transform: none; font-size: 0.85rem; }
  .stores__name { font-size: 1.05rem; font-weight: 600; font-family: 'Hanken Grotesk Variable', Arial, sans-serif; }
</style>
