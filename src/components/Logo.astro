---
/**
 * Signature logo: "Mohamed Hammad" handwritten in gold (Herr Von Muellerhoff).
 * The large variant adds a pen swash and a small-caps line underneath.
 */
interface Props {
  size?: 'header' | 'large';
  tagline?: string;
}
const { size = 'header', tagline } = Astro.props;
---
<span class:list={['logo', `logo--${size}`]}>
  <span class="logo__sign" lang="en">Mohamed Hammad</span>
  {size === 'large' && (
    <svg class="logo__swash" viewBox="0 0 300 14" aria-hidden="true" focusable="false">
      <path d="M2 9 C 70 2, 170 2, 238 6 S 290 12, 298 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
    </svg>
  )}
  {size === 'large' && tagline && <span class="logo__tagline">{tagline}</span>}
</span>

<style>
  .logo { display: inline-grid; justify-items: start; color: var(--gold); }
  .logo__sign {
    font-family: 'Herr Von Muellerhoff', 'Snell Roundhand', cursive;
    font-weight: 400;
    line-height: 0.9;
    white-space: nowrap;
    color: var(--gold);
    /* Script glyphs overhang their box; keep room so swashes are not clipped. */
    padding-inline: 0.1em 0.25em;
    padding-block: 0.12em 0.05em;
  }
  .logo--header .logo__sign { font-size: 2.6rem; }
  .logo--large .logo__sign { font-size: clamp(3rem, 2.2rem + 2.4vw, 4.2rem); }
  .logo__swash { width: 13rem; height: 0.8rem; margin-top: -0.2rem; color: var(--gold); }
  .logo__tagline {
    margin-top: 0.6rem;
    font-family: 'Hanken Grotesk Variable', Arial, sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--muted);
  }
  :global([dir='rtl']) .logo__tagline { font-family: var(--f-ar-body); letter-spacing: 0; font-size: 0.85rem; }
  :global([dir='rtl']) .logo { justify-items: end; }

  @media (max-width: 30rem) {
    .logo--header .logo__sign { font-size: 2.2rem; }
  }
</style>
